C=gcc

ASMFLAGS = -S
OPTIMIZATION = -O2
CORE_DIR = ./Core
OUTPUT_DIR = ./output

TARGET_PARAMETERS = $(OUTPUT_DIR)/parameters
PARAMETERS_SRC = $(CORE_DIR)/parameters.c

FLAGS = -Wall -Wextra -DNUM_OF_BRANCHES=$(NUM_OF_BRANCHES) -I/usr/local/include -L/usr/local/lib -Wl,-rpath-link=/usr/local/lib -lpapi
DEBUG_FLAGS = -g

all: TARGET

clean:
	rm -f $(OUTPUT_DIR)/parameters

debug: clean PARAMETERS_D

TARGET: PARAMETERS

PARAMETERS: PARAMETERS_O PARAMETERS_S

PARAMETERS_O:
		$(CC) $(PARAMETERS_SRC) $(FLAGS) $(OPTIMIZATION) -o $(TARGET_PARAMETERS)

PARAMETERS_S:
		$(CC) $(PARAMETERS_SRC) $(ASMFLAGS) $(FLAGS) $(OPTIMIZATION) -o $(TARGET_PARAMETERS).s

PARAMETERS_D:
		$(CC) $(PARAMETERS_SRC) $(FLAGS) $(DEBUG_FLAGS) $(OPTIMIZATION) -o $(TARGET_PARAMETERS)


