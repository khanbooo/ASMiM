C=gcc

ASMFLAGS = -S
OPTIMIZATION = -O1
CORE_DIR = ./Core
OUTPUT_DIR = ./output
TARGET_RAND = $(OUTPUT_DIR)/rand
TARGET_SQUARE = $(OUTPUT_DIR)/square

RAND_SRC = $(CORE_DIR)/rand.c
SQUARE_SRC = $(CORE_DIR)/square.c

FLAGS = -Wall -Wextra -DTEST_NOPS=$(TEST_NOPS)
DEBUG_FLAGS = -g

all: TARGET

clean:
	rm -f $(OUTPUT_DIR)/rand

debug: clean RAND_D SQUARE_D

TARGET: RAND SQUARE

RAND: RAND_O RAND_S

SQUARE: SQUARE_O SQUARE_S
		
RAND_O:
		$(CC) $(RAND_SRC) $(FLAGS) $(OPTIMIZATION) -o $(TARGET_RAND)

SQUARE_O:
		$(CC) $(SQUARE_SRC) $(FLAGS) -ffast-math $(OPTIMIZATION) -o $(TARGET_SQUARE)

RAND_S:
		$(CC) $(RAND_SRC) $(ASMFLAGS) $(FLAGS) $(OPTIMIZATION) -o $(TARGET_RAND).s

SQUARE_S:
		$(CC) $(SQUARE_SRC) $(ASMFLAGS) $(FLAGS) -ffast-math $(OPTIMIZATION) -o $(TARGET_SQUARE).s

RAND_D:
		$(CC) $(RAND_SRC) $(FLAGS) $(DEBUG_FLAGS) $(OPTIMIZATION) -o $(TARGET_RAND)

SQUARE_D:
		$(CC) $(SQUARE_SRC) $(FLAGS) $(DEBUG_FLAGS) -ffast-math $(OPTIMIZATION) -o $(TARGET_SQUARE)

