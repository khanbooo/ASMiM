CC=gcc

ASMFLAGS = -S
OPTIMIZATION = -O0
OUTPUT_DIR = ../output
TARGET_LATENCY  = $(OUTPUT_DIR)/latency
TARGET_THROUGHPUT  = $(OUTPUT_DIR)/throughput

LATENCY_SRC = ./latency.c
THROUGHPUT_SRC = ./throughput.c 

all: TARGET

clean:
	rm $(OUTPUT_DIR)/*.s
	rm $(OUTPUT_DIR)/*.o

TARGET: LATENCY THROUGHPUT

LATENCY: LATENCY_O LATENCY_S

THROUGHPUT: THROUGHPUT_O THROUGHPUT_S
	
LATENCY_O:
	$(CC) $(LATENCY_SRC) $(OPTIMIZATION) -o $(TARGET_LATENCY).o

THROUGHPUT_O:
	$(CC) $(THROUGHPUT_SRC) $(OPTIMIZATION) -o $(TARGET_THROUGHPUT).o

LATENCY_S:
	$(CC) $(LATENCY_SRC) $(ASMFLAGS) $(OPTIMIZATION) -o $(TARGET_LATENCY).s

THROUGHPUT_S:
	$(CC) $(THROUGHPUT_SRC) $(ASMFLAGS) $(OPTIMIZATION) -o $(TARGET_THROUGHPUT).s
